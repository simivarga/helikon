---
/**
 * Minimal line icons for the room amenity list. Deliberately drawn on one
 * 24×24 grid with a single stroke weight so the row reads as one set rather
 * than assorted pictograms.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  // wall-mounted air conditioner with airflow beneath
  ac: 'M3 5.5h18v6H3zM6.5 8.5h11M7 15c1.2 0 1.2 1.6 2.4 1.6M12 15c1.2 0 1.2 1.6 2.4 1.6M17 15c-.9 0-1 1.6-1.9 1.6',
  // shower head over a tub lip
  bath: 'M4 20.5h16M4 16.5h16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM7 16.5v-6a3.5 3.5 0 0 1 7 0M17 4.5v4M15 8.5h4',
  tv: 'M3 4.5h18v11H3zM9 20h6M12 15.5V20',
  wifi: 'M2.5 8.5a14 14 0 0 1 19 0M6 12.2a9 9 0 0 1 12 0M9.4 15.8a4.2 4.2 0 0 1 5.2 0M12 19.4h.01',
  // a wall with sound waves stopped at it
  sound: 'M14.5 3.5v17M14.5 3.5 9 7.5v9l5.5 4M4.5 10v4M18.5 8.6a5 5 0 0 1 0 6.8M21 6.2a8.5 8.5 0 0 1 0 11.6',
  // parasol over a small table
  patio: 'M12 11.5V21M8.5 21h7M3 11.5a9 9 0 0 1 18 0zM12 11.5V3',
  // balcony railing
  balcony: 'M3 9.5h18M4.5 9.5V20M19.5 9.5V20M9.5 9.5V20M14.5 9.5V20M3 20h18M6 6.5h12',
  fridge: 'M5 3.5h14v17H5zM5 10h14M8.5 6v2M8.5 13v2.5',
};

const d = paths[name] ?? paths.wifi;
---

<svg
  class:list={['amenity-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>

<style>
  /* Sized here, not by the parent: Astro scopes styles per component, so a
     `.room__amenity-icon { width }` rule written in Rooms.astro never matched
     this svg — it carries this component's scope id, not that one's. The icons
     rendered at their intrinsic grid size (111px) as a result. */
  .amenity-icon {
    width: var(--amenity-icon-size, 1.05rem);
    height: var(--amenity-icon-size, 1.05rem);
    flex-shrink: 0;
  }
</style>
