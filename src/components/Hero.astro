---
import { Image } from 'astro:assets';
import gardenBridge from '../assets/photos/garden-bridge.jpg';
import Stars from './Stars.astro';
import { FACTS } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations, formatNumber, plural } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const words = t('hero.title').split(' ');
const score = locale === 'en' ? FACTS.ratingScoreEn : FACTS.ratingScore;
const reviewNoun = plural(locale, FACTS.ratingCount, {
  one: t('hero.reviews.one'),
  few: t('hero.reviews.few'),
  many: t('hero.reviews.many'),
  other: t('hero.reviews.other'),
});
---

<section class="hero grain scrim" aria-labelledby="hero-title">
  <div class="hero__media">
    <Image
      src={gardenBridge}
      alt={t('hero.imageAlt')}
      widths={[640, 960, 1280]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__image"
    />
  </div>

  <div class="gutter hero__inner">
    <p class="eyebrow hero__eyebrow" style="--d:0.15s">
      <Stars class="text-gold-500" />
      <span>{t('hero.eyebrow')}</span>
    </p>

    <h1 class="hero__title" id="hero-title">
      {
        words.map((word, i) => (
          <>
            {/* A real space, not just the span's margin: without it the H1's
                accessible name ran every word together into one string. */}
            {i > 0 && ' '}
            <span class="hero__word" style={`--i:${i}`}>{word}</span>
          </>
        ))
      }
    </h1>

    <div class="hero__meta" style={`--d:${0.4 + words.length * 0.05}s`}>
      <span class="hero__score">
        <strong>{score}</strong>
        <span class="hero__score-max">/ 10</span>
      </span>
      <span class="hero__meta-sep" aria-hidden="true"></span>
      <span>{`${formatNumber(locale, FACTS.ratingCount)} ${reviewNoun}`}</span>
      <span class="hero__meta-sep" aria-hidden="true"></span>
      <span>{t('hero.rating')}</span>
    </div>

    <div class="hero__actions" style={`--d:${0.5 + words.length * 0.05}s`}>
      <a href={FACTS.booking} target="_blank" rel="noopener" class="btn btn-gold">{t('hero.cta.book')}</a>
      <a href="#rooms" class="btn btn-outline">{t('hero.cta.rooms')}</a>
    </div>
  </div>

  <a href="#welcome" class="hero__scroll" style="--d:1.3s" aria-label={t('hero.scroll')}>
    <span class="eyebrow">{t('hero.scroll')}</span>
    <span class="hero__scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }

  :global(.js) .hero__image {
    transform: scale(1.08);
    animation: hero-settle 2.6s var(--ease-out-expo) forwards;
  }

  @keyframes hero-settle {
    to {
      transform: scale(1);
    }
  }

  .hero__inner {
    width: 100%;
    position: relative;
    z-index: 3;
    padding-bottom: clamp(5rem, 12vh, 9rem);
    padding-top: 9rem;
  }

  /* Bumped up from the 0.72rem default eyebrow: at the small size the place
     name was the least readable thing in the hero. */
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.7rem;
    font-size: 0.92rem;
    letter-spacing: 0.2em;
    color: var(--color-gold-400);
    text-shadow: 0 1px 18px oklch(0.16 0.05 139.5 / 0.8);
  }

  .hero__eyebrow :global(svg) {
    width: 0.78em;
    height: 0.78em;
  }

  /* display-md, not -lg: the Ukrainian tagline is six long words, and at the
     larger step it filled the whole viewport and pushed the CTAs off-screen. */
  .hero__title {
    font-size: var(--text-display-md);
    max-width: 20ch;
    color: var(--color-cream);
    text-shadow: 0 2px 50px oklch(0.185 0.055 139.5 / 0.5);
  }

  .hero__word {
    display: inline-block;
  }

  :global(.js) .hero__word {
    opacity: 0;
    transform: translateY(0.45em);
    animation: word-in 1.2s var(--ease-out-expo) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.05s);
  }

  @keyframes word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Also enlarged, given its own solid colour rather than a transparent cream,
     and backed by a shadow: it sits directly on photography. */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2.2rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-cream);
    text-shadow: 0 1px 20px oklch(0.16 0.05 139.5 / 0.85);
  }

  .hero__score {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .hero__score strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-gold-500);
  }

  .hero__score-max {
    font-size: 0.8rem;
  }

  .hero__meta-sep {
    width: 1.5rem;
    height: 1px;
    background: color-mix(in oklab, var(--color-gold-500) 45%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.4rem;
  }

  .hero__scroll {
    position: absolute;
    inset-inline: 0;
    bottom: 1.6rem;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    font-size: 0.62rem;
    transition: color 0.4s var(--ease-out-quart);
  }
  .hero__scroll:hover {
    color: var(--color-cream);
  }

  .hero__scroll-line {
    width: 1px;
    height: 2.6rem;
    background: linear-gradient(to bottom, var(--color-gold-500), transparent);
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  /* Everything above the fold animates on load, never on scroll, so nothing
     can be stranded invisible if the observer is slow. */
  :global(.js) .hero__eyebrow,
  :global(.js) .hero__meta,
  :global(.js) .hero__actions,
  :global(.js) .hero__scroll {
    opacity: 0;
    transform: translateY(0.8rem);
    animation: fade-up 1.1s var(--ease-out-expo) forwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__image,
    :global(.js) .hero__word,
    :global(.js) .hero__eyebrow,
    :global(.js) .hero__meta,
    :global(.js) .hero__actions,
    :global(.js) .hero__scroll,
    .hero__scroll-line {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
