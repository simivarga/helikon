---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  photos: ImageMetadata[];
  label: string;
  /** Unique per instance so several carousels can share a page. */
  id: string;
  /** Must match the caller's real rendered width, not the default. */
  sizes?: string;
  /** Load the first slide eagerly, for a carousel that is the page's opening
      image. Everything else stays lazy. */
  eager?: boolean;
}
const { photos, label, id, sizes = '(max-width: 900px) 100vw, 48vw', eager = false } = Astro.props;

// Arrow glyphs read poorly as accessible names, and were identical in every
// locale. These describe the action instead.
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const multiple = photos.length > 1;
// "Mansard room, photo 2 / 5": spoken cleanly by screen readers.
const photoWord = t('carousel.photo').toLocaleLowerCase(locale);
---

<!-- Native scroll-snap does the scrolling; the buttons and dots only nudge it.
     That keeps touch swiping, trackpads and keyboards all working without a
     carousel library, and it degrades to a plain scrollable strip with no JS. -->
<div class="carousel" data-carousel={id}>
  <div class="carousel__track" data-track role="group" aria-roledescription="carousel" aria-label={label}>
    {
      photos.map((photo, i) => (
        <figure class="carousel__slide" data-slide aria-label={`${i + 1} / ${photos.length}`}>
          {/* Lazy by default. Every carousel on the home page sits well below
              the fold, so marking each first slide eager pulled ~677 kB of
              unseen photography into the initial load. A room page opens on
              its carousel, so there the first slide is the LCP image. */}
          <Image
            src={photo}
            alt={`${label}, ${photoWord} ${i + 1} / ${photos.length}`}
            widths={[480, 720, 1000]}
            sizes={sizes}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
          />
        </figure>
      ))
    }
  </div>

  {
    multiple && (
      <>
        <button type="button" class="carousel__nav carousel__nav--prev" data-prev aria-label={t('carousel.prev')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <button type="button" class="carousel__nav carousel__nav--next" data-next aria-label={t('carousel.next')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div class="carousel__dots" data-dots>
          {photos.map((_, i) => <button type="button" class="carousel__dot" data-dot={i} aria-label={`${t('carousel.photo')} ${i + 1}`} />)}
        </div>

        <p class="carousel__count" data-count aria-hidden="true">1 / {photos.length}</p>
      </>
    )
  }
</div>

<style>
  .carousel {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }

  .carousel__slide img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* Controls stay hidden until the carousel is hovered or focused, so at rest
     the photograph is uninterrupted. On touch they are always visible.
     Solid surfaces, not frosted glass: the contrast of the icon and the
     counter must not depend on the photograph behind them. */
  .carousel__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-gold-700);
    border-radius: var(--radius-control, 3px);
    background: var(--color-forest-950);
    color: var(--color-cream);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.4s var(--ease-out-quart),
      background-color 0.3s var(--ease-out-quart);
  }

  .carousel__nav svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .carousel__nav--prev {
    left: 0.75rem;
  }
  .carousel__nav--next {
    right: 0.75rem;
  }

  .carousel:hover .carousel__nav,
  .carousel:focus-within .carousel__nav {
    opacity: 1;
  }

  .carousel__nav:hover {
    background: var(--color-gold-500);
    border-color: var(--color-gold-500);
    color: var(--color-forest-950);
  }

  @media (hover: none) {
    .carousel__nav {
      opacity: 1;
    }
  }

  /* Each button is its own 28 x 36 hit box, laid edge to edge with no gap so
     neighbouring targets never overlap. The visible dot is drawn inside it,
     and the active pill (21.6px) still fits within its own box. */
  .carousel__dots {
    position: absolute;
    inset-inline: 0;
    bottom: 0.2rem;
    display: flex;
    justify-content: center;
    /* The row spans the full width; only the buttons may catch touches, so a
       swipe that starts beside the dots still moves the strip. */
    pointer-events: none;
  }

  .carousel__dot {
    position: relative;
    width: 1.75rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
  }

  .carousel__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.4rem;
    height: 0.4rem;
    translate: -50% -50%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-cream) 45%, transparent);
    transition:
      background-color 0.35s var(--ease-out-quart),
      width 0.35s var(--ease-out-expo);
  }

  .carousel__dot[aria-current='true']::before {
    width: 1.35rem;
    background: var(--color-gold-500);
  }

  .carousel__count {
    position: absolute;
    top: 0.85rem;
    right: 0.9rem;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-control, 3px);
    background: var(--color-forest-950);
    font-size: var(--text-label, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (slides.length < 2) return;

    let index = 0;
    // While a button-driven scroll is in flight, `index` is the truth and the
    // scroll position is not: every intermediate position is closer to some
    // other slide. Reading the index back from those positions is what made
    // rapid clicks race each other and land a slide too far.
    let target: number | null = null;
    let retries = 0;
    let idle = 0;
    let raf = 0;

    const leftOf = (i: number) => slides[i].offsetLeft - track.offsetLeft;

    const nearest = () => {
      let best = 0;
      let bestDelta = Infinity;
      slides.forEach((_, i) => {
        const delta = Math.abs(leftOf(i) - track.scrollLeft);
        if (delta < bestDelta) {
          bestDelta = delta;
          best = i;
        }
      });
      return best;
    };

    const render = () => {
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
      if (count) count.textContent = `${index + 1} / ${slides.length}`;
      // No disabled state: the arrows wrap, so both are always live.
    };

    const sync = () => {
      const i = nearest();
      if (i !== index) {
        index = i;
        render();
      }
    };

    // The strip has come to rest (scrollend, or no scroll event for a while
    // where scrollend is unsupported). Release a programmatic scroll once it
    // has arrived, then trust the position again. A user swipe clears
    // `target` itself (see handOver), so coming to rest short of the target
    // means the engine dropped the scroll: WebKit abandons a smooth scroll
    // that is retargeted many times in quick succession. Ask again, and jump
    // on the last attempt.
    const settle = () => {
      window.clearTimeout(idle);
      if (target !== null) {
        if (Math.abs(leftOf(target) - track.scrollLeft) >= 2 && retries < 3) {
          retries += 1;
          track.scrollTo({ left: leftOf(target), behavior: retries < 3 ? 'smooth' : 'instant' });
          idle = window.setTimeout(settle, 250);
          return;
        }
        target = null;
      }
      sync();
    };

    const go = (i: number) => {
      // Wrap: past the last photo comes the first, and vice versa.
      const n = slides.length;
      index = ((i % n) + n) % n;
      target = index;
      retries = 0;
      track.scrollTo({ left: leftOf(index), behavior: 'smooth' });
      render();
      window.clearTimeout(idle);
      idle = window.setTimeout(settle, 200);
    };

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    // A finger or a trackpad takes over from any scroll we started.
    const handOver = () => {
      target = null;
    };
    track.addEventListener('touchstart', handOver, { passive: true });
    track.addEventListener('wheel', handOver, { passive: true });
    track.addEventListener('pointerdown', handOver, { passive: true });

    // Keep the dots in step while the user swipes or scrolls the strip.
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(idle);
        idle = window.setTimeout(settle, 150);
        if (target !== null) return;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(sync);
      },
      { passive: true },
    );
    track.addEventListener('scrollend', settle);

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
      }
    });
    track.tabIndex = 0;

    render();
  });
</script>
