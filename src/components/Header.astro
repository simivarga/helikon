---
import Stars from './Stars.astro';
import { FACTS, LOCALE_LABELS } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations, alternatePaths, localePath, LOCALES } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const alternates = alternatePaths(Astro.url.pathname);

const nav = [
  { key: 'nav.rooms', href: '#rooms' },
  { key: 'nav.pool', href: '#pool' },
  { key: 'nav.restaurant', href: '#restaurant' },
  { key: 'nav.wellness', href: '#wellness' },
  { key: 'nav.events', href: '#events' },
  { key: 'nav.contact', href: '#contact' },
];
---

<header data-header class="site-header">
  <div class="gutter flex items-center gap-6">
    <a href={localePath(locale)} class="brand-link" aria-label="Helikon">
      <span class="brand-name">Helikon</span>
      <span class="brand-meta">
        <Stars class="text-gold-500 text-[0.62rem]" />
        <span class="brand-est">Est. 2005</span>
      </span>
    </a>

    <nav aria-label={t('nav.menu')} class="header-nav">
      {nav.map((item) => <a href={item.href} class="nav-link">{t(item.key)}</a>)}
    </nav>

    <div class="lang-group" role="group" aria-label={t('nav.language')}>
      {
        LOCALES.map((l, i) => (
          <>
            {i > 0 && <span class="lang-sep" aria-hidden="true">/</span>}
            <a
              href={alternates[l]}
              hreflang={l}
              aria-current={l === locale ? 'true' : undefined}
              class:list={['lang-link', l === locale && 'is-active']}
            >
              {LOCALE_LABELS[l]}
            </a>
          </>
        ))
      }
    </div>

    <a href={FACTS.booking} target="_blank" rel="noopener" class="book-button">{t('nav.book')}</a>

    <button
      type="button"
      class="burger"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t('nav.menu')}
      data-menu-toggle
    >
      <span class="burger__bar"></span>
      <span class="burger__bar"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-menu inert>
  <nav aria-label={t('nav.menu')} class="mobile-menu__nav">
    {nav.map((item) => <a href={item.href}>{t(item.key)}</a>)}
  </nav>

  <div class="mobile-menu__foot">
    <a href={FACTS.booking} target="_blank" rel="noopener" class="btn btn-gold">{t('nav.book')}</a>

    <div class="mobile-menu__langs" role="group" aria-label={t('nav.language')}>
      {
        LOCALES.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            <a href={alternates[l]} hreflang={l} aria-current={l === locale ? 'true' : undefined}>
              {LOCALE_LABELS[l]}
            </a>
          </>
        ))
      }
    </div>

    <a href={`tel:${FACTS.phone}`} class="mobile-menu__phone">{FACTS.phoneDisplay}</a>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      // `inert` keeps the closed overlay out of the tab order and away from
      // screen readers even while its exit transition is still running.
      if (open) menu.removeAttribute('inert');
      else menu.setAttribute('inert', '');
      document.documentElement.classList.toggle('menu-open', open);
      // Lenis owns the scroll position, so pausing it is what locks the page.
      const lenis = (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
      if (open) lenis?.stop();
      else lenis?.start();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* Transparent over the hero photograph, then a dark blurred bar once the
     hero is behind us. Text stays cream throughout, so it never has to
     switch colour mid-scroll. */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-block: 1.6rem;
    transition:
      padding-block 0.6s var(--ease-out-expo),
      background-color 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }

  /* A dedicated scrim behind the transparent header. Without it the nav sits
     directly on the photograph and legibility depends on whatever happens to
     be in the top of the image. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    bottom: -2.5rem;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      oklch(0.185 0.055 139.5 / 0.82) 0%,
      oklch(0.185 0.055 139.5 / 0.55) 45%,
      transparent 100%
    );
    transition: opacity 0.6s var(--ease-out-expo);
  }

  /* Once the bar itself is opaque the scrim is redundant. */
  .site-header.is-condensed::before {
    opacity: 0;
  }

  .site-header.is-condensed {
    padding-block: 0.75rem;
    background-color: color-mix(in oklab, var(--color-forest-950) 82%, transparent);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-gold-700) 28%, transparent);
  }

  /* ---- brand ----------------------------------------------------------- */

  .brand-link {
    margin-right: auto;
    display: grid;
    gap: 0.15rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--color-cream);
  }

  .brand-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-est {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-gold-500) 80%, transparent);
  }

  /* ---- nav ------------------------------------------------------------- */

  .header-nav {
    display: none;
    align-items: center;
    gap: clamp(1.1rem, 2.1vw, 1.9rem);
  }

  @media (min-width: 1080px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    padding-block: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--color-cream);
    transition: color 0.3s var(--ease-out-quart);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-expo);
  }

  .nav-link:hover {
    color: var(--color-cream);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* ---- language -------------------------------------------------------- */

  .lang-group {
    display: none;
    align-items: center;
  }

  @media (min-width: 640px) {
    .lang-group {
      display: flex;
    }
  }

  .lang-sep {
    color: color-mix(in oklab, var(--color-cream) 30%, transparent);
  }

  .lang-link {
    padding: 0.25rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    transition: color 0.3s var(--ease-out-quart);
  }
  .lang-link:hover {
    color: var(--color-cream);
  }
  .lang-link.is-active {
    color: var(--color-gold-500);
  }

  /* ---- book ------------------------------------------------------------ */

  .book-button {
    display: none;
    border-radius: 999px;
    background: var(--color-gold-500);
    padding: 0.66rem 1.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-forest-950);
    transition:
      transform 0.45s var(--ease-out-expo),
      background-color 0.35s var(--ease-out-quart);
  }
  .book-button:hover {
    background: var(--color-gold-400);
    transform: translateY(-2px);
  }

  @media (min-width: 768px) {
    .book-button {
      display: inline-block;
    }
  }

  /* ---- burger ---------------------------------------------------------- */
  /* Both bars share one vertical centre so the open state is a true X. */

  .burger {
    position: relative;
    width: 40px;
    height: 40px;
    margin-right: -7px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media (min-width: 1080px) {
    .burger {
      display: none;
    }
  }

  .burger__bar {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 50%;
    height: 1.5px;
    background: var(--color-cream);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .burger__bar:first-of-type {
    transform: translateY(-4px);
  }
  .burger__bar:last-of-type {
    transform: translateY(4px);
  }

  .burger.is-open .burger__bar:first-of-type {
    transform: rotate(45deg);
  }
  .burger.is-open .burger__bar:last-of-type {
    transform: rotate(-45deg);
  }

  /* ---- mobile menu ----------------------------------------------------- */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: 6.5rem clamp(1.25rem, 5vw, 5rem) 3rem;
    background: var(--color-forest-950);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.75s var(--ease-out-expo);
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }

  @media (min-width: 1080px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu__nav {
    display: grid;
    gap: 0.3rem;
  }

  .mobile-menu__nav a {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8.5vw, 2.75rem);
    line-height: 1.2;
    color: var(--color-cream);
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }

  .mobile-menu.is-open .mobile-menu__nav a {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__nav a:nth-child(1) { transition-delay: 0.14s; }
  .mobile-menu__nav a:nth-child(2) { transition-delay: 0.19s; }
  .mobile-menu__nav a:nth-child(3) { transition-delay: 0.24s; }
  .mobile-menu__nav a:nth-child(4) { transition-delay: 0.29s; }
  .mobile-menu__nav a:nth-child(5) { transition-delay: 0.34s; }
  .mobile-menu__nav a:nth-child(6) { transition-delay: 0.39s; }

  .mobile-menu__foot {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .mobile-menu__langs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, var(--color-cream) 35%, transparent);
  }

  .mobile-menu__langs a {
    color: color-mix(in oklab, var(--color-cream) 70%, transparent);
  }

  .mobile-menu__langs a[aria-current='true'] {
    color: var(--color-gold-500);
  }

  .mobile-menu__phone {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-forest-200);
  }

  /* While the overlay is open only the close button stays visible. */
  :global(html.menu-open) .site-header {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }

  :global(html.menu-open) .brand-link,
  :global(html.menu-open) .header-nav,
  :global(html.menu-open) .lang-group,
  :global(html.menu-open) .book-button {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-out-quart);
  }
</style>
