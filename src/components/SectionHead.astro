---
interface Props {
  /** Optional, and deliberately rare: only pass one when it tells the reader
      something the heading does not. A label that just repeats the section's
      nav name above a heading about the same thing is noise. */
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  class?: string;
  /** Set when the enclosing <section> points at this heading with
      aria-labelledby, so screen readers announce a named region. */
  headingId?: string;
}
const { eyebrow, title, lede, align = 'start', class: className = '', headingId } = Astro.props;
---

<div class:list={['section-head', align === 'center' && 'is-center', className]}>
  {eyebrow && <p class="eyebrow section-head__eyebrow">{eyebrow}</p>}
  <h2 class="section-head__title" id={headingId}>{title}</h2>
  {lede && <p class="section-head__lede">{lede}</p>}
  <hr class="rule-gold section-head__rule" />
</div>

<style>
  .section-head {
    display: grid;
    gap: 0;
  }

  .section-head.is-center {
    justify-items: center;
    text-align: center;
  }

  .section-head__eyebrow {
    margin-bottom: 1.1rem;
    color: var(--color-gold-500);
    font-size: 0.78rem;
  }

  /* Light grounds need the deeper bronze: gold-500 measures 2.8:1 on sand. */
  :global(.section-light) .section-head__eyebrow {
    color: var(--color-bronze-600);
  }

  .section-head__title {
    font-size: var(--text-display-sm);
    max-width: 22ch;
  }

  .section-head.is-center .section-head__title {
    max-width: 26ch;
  }

  /* An opaque secondary tone, not a transparent cream: the wellness heading
     sits over a photograph, where transparency loses contrast unpredictably. */
  .section-head__lede {
    margin-top: 1.4rem;
    max-width: 56ch;
    color: var(--color-cream-muted);
  }

  :global(.section-light) .section-head__lede {
    color: color-mix(in oklab, var(--color-forest-900) 78%, var(--color-sand-200));
  }

  .section-head__rule {
    margin-top: 2rem;
  }

  .section-head.is-center .section-head__rule {
    background: linear-gradient(to right, transparent, var(--color-gold-500), transparent);
  }
</style>
