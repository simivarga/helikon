---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  class?: string;
}
const { eyebrow, title, lede, align = 'start', class: className = '' } = Astro.props;
---

<div class:list={['section-head', align === 'center' && 'is-center', className]}>
  <p class="eyebrow section-head__eyebrow" data-reveal>{eyebrow}</p>
  <h2 class="section-head__title" data-reveal>{title}</h2>
  {lede && <p class="section-head__lede" data-reveal>{lede}</p>}
  <hr class="rule-gold section-head__rule" data-reveal />
</div>

<style>
  .section-head {
    display: grid;
    gap: 0;
  }

  .section-head.is-center {
    justify-items: center;
    text-align: center;
  }

  .section-head__eyebrow {
    color: var(--color-gold-500);
    font-size: 0.78rem;
  }

  /* Light grounds need the deeper bronze: gold-500 measures 2.8:1 on sand. */
  :global(.section-light) .section-head__eyebrow {
    color: var(--color-bronze-600);
  }

  .section-head__title {
    margin-top: 1.1rem;
    font-size: var(--text-display-sm);
    max-width: 22ch;
  }

  .section-head.is-center .section-head__title {
    max-width: 26ch;
  }

  .section-head__lede {
    margin-top: 1.4rem;
    max-width: 56ch;
    color: color-mix(in oklab, currentColor 78%, transparent);
  }

  .section-head__rule {
    margin-top: 2rem;
  }

  .section-head.is-center .section-head__rule {
    background: linear-gradient(to right, transparent, var(--color-gold-500), transparent);
  }
</style>
