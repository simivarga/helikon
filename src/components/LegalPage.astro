---
import Base from '../layouts/Base.astro';
import { FACTS } from '../i18n/ui';
import { legal, LEGAL_UPDATED, type LegalKind } from '../i18n/legal';
import { getLocaleFromUrl } from '../i18n/utils';

interface Props {
  kind: LegalKind;
}

const { kind } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const copy = legal[locale];
const doc = copy[kind];

const INTL_TAG = { uk: 'uk-UA', hu: 'hu-HU', en: 'en-GB' } as const;
const updated = new Intl.DateTimeFormat(INTL_TAG[locale], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${LEGAL_UPDATED}T00:00:00Z`));

/** Split copy on the inline tokens so the email and phone render as links. */
function parts(text: string) {
  return text.split(/(\{email\}|\{phone\})/).filter(Boolean);
}
---

<Base title={doc.title} description={doc.description}>
  <article class="legal" aria-labelledby="legal-title">
    <header class="gutter legal__head">
      <div class="legal__measure">
        <p class="eyebrow legal__eyebrow">{doc.eyebrow}</p>
        <h1 id="legal-title" class="legal__title">{doc.heading}</h1>
        <p class="legal__lede">{doc.lede}</p>
        <p class="legal__updated">
          {copy.updated}: <time datetime={LEGAL_UPDATED}>{updated}</time>
        </p>
        <hr class="rule-gold legal__rule" />
      </div>
    </header>

    <div class="section-light legal__body">
      <div class="gutter">
        <div class="legal__measure legal__prose">
          {
            doc.sections.map((section) => (
              <section>
                <h2>{section.heading}</h2>
                {section.blocks.map((block) => {
                  if ('contact' in block) {
                    return (
                      <address class="legal__contact">
                        {copy.address.map((line, i) => (i === 0 ? <strong>{line}</strong> : <span>{line}</span>))}
                        <span>
                          {copy.emailLabel}: <a href={`mailto:${FACTS.email}`}>{FACTS.email}</a>
                        </span>
                        <span>
                          {copy.phoneLabel}: <a href={`tel:${FACTS.phone}`}>{FACTS.phoneDisplay}</a>
                        </span>
                      </address>
                    );
                  }
                  if ('list' in block) {
                    return (
                      <ul>
                        {block.list.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    );
                  }
                  return (
                    <p>
                      {parts(block.p).map((part) =>
                        part === '{email}' ? (
                          <a href={`mailto:${FACTS.email}`}>{FACTS.email}</a>
                        ) : part === '{phone}' ? (
                          <a href={`tel:${FACTS.phone}`}>{FACTS.phoneDisplay}</a>
                        ) : (
                          part
                        ),
                      )}
                    </p>
                  );
                })}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .legal__head {
    /* Clears the fixed header, which is ~5.5rem tall before it condenses. */
    padding-block: clamp(8rem, 14vw, 11rem) clamp(3rem, 6vw, 4.5rem);
  }

  .legal__measure {
    max-width: 68ch;
    margin-inline: auto;
  }

  .legal__eyebrow {
    color: var(--color-gold-500);
    font-size: 0.78rem;
  }

  .legal__title {
    margin-top: 1.1rem;
    font-size: var(--text-display-sm);
  }

  .legal__lede {
    margin-top: 1.5rem;
    font-size: 1.12rem;
    color: var(--color-cream-muted);
  }

  .legal__updated {
    margin-top: 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-cream-muted);
  }

  .legal__rule {
    margin-top: 2rem;
  }

  .legal__body {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(4.5rem, 9vw, 7rem);
  }

  .legal__prose section + section {
    margin-top: clamp(2.5rem, 5vw, 3.25rem);
  }

  .legal__prose h2 {
    font-size: var(--text-display-xs);
    line-height: 1.15;
  }

  .legal__prose p,
  .legal__prose ul,
  .legal__prose address {
    margin-top: 1rem;
  }

  .legal__prose h2 + p,
  .legal__prose h2 + address {
    margin-top: 1.1rem;
  }

  .legal__prose ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.25rem;
    list-style: none;
  }

  .legal__prose li {
    position: relative;
  }

  .legal__prose li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.78em;
    width: 0.45rem;
    height: 1px;
    background: var(--color-bronze-600);
  }

  .legal__prose a {
    color: var(--color-forest-900);
    text-decoration: underline;
    text-decoration-color: var(--color-bronze-600);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    /* The email address is one unbreakable token on a phone. */
    overflow-wrap: anywhere;
  }

  .legal__prose a:hover {
    text-decoration-thickness: 2px;
  }

  .legal__contact {
    display: grid;
    gap: 0.1rem;
    padding: 1.1rem 1.3rem;
    border-left: 2px solid var(--color-bronze-600);
    background: color-mix(in oklab, var(--color-sand-100) 70%, transparent);
    font-style: normal;
  }

  .legal__contact strong {
    font-weight: 600;
  }
</style>
