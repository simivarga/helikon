---
import SectionHead from './SectionHead.astro';
import Stars from './Stars.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const milestones = [
  { year: t('story.q1'), label: t('story.q1label') },
  { year: t('story.q2'), label: t('story.q2label') },
  { year: t('story.q3'), label: t('story.q3label') },
  { year: t('story.q4'), label: t('story.q4label') },
];
---

<section id="story" aria-labelledby="story-title" class="story">
  <div class="gutter story__grid">
    <div>
      <SectionHead headingId="story-title" title={t('story.title')} />
      <div class="story__body">
        <p>{t('story.body1')}</p>
        <p>{t('story.body2')}</p>
      </div>
      <p class="story__signature">
        <Stars class="text-gold-500 text-[0.7rem]" />
        <span>Helikon · Est. 2005</span>
      </p>
    </div>

    <ol class="story__timeline">
      {
        milestones.map((m) => (
          <li class="story__milestone">
            <span class="story__year">{m.year}</span>
            <span class="story__label">{m.label}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .story {
    position: relative;
    background: var(--color-forest-950);
  }

  .story__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: var(--spacing-section);
  }

  @media (min-width: 900px) {
    .story__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .story__body {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
    max-width: 56ch;
    color: var(--color-cream-muted);
  }

  .story__signature {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-500);
  }

  /* The years as a ruled table: a hairline above each row, the year set large
     and the event beside it. Two columns of two on phones, one column of four
     from 560px up. No spine and no dots: the order of the rows already says
     it is a sequence. */
  .story__timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
  }

  .story__milestone {
    padding-block: 1.1rem 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-gold-700) 45%, var(--color-forest-950));
  }

  @media (min-width: 560px) {
    .story__timeline {
      grid-template-columns: 1fr;
    }

    .story__milestone {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: 1.25rem;
      padding-block: 1.25rem;
    }

    .story__milestone:last-child {
      border-bottom: 1px solid color-mix(in oklab, var(--color-gold-700) 45%, var(--color-forest-950));
    }
  }

  .story__year {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1;
    color: var(--color-gold-500);
  }

  .story__label {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-cream-muted);
  }

  @media (min-width: 560px) {
    .story__label {
      margin-top: 0;
      font-size: 0.95rem;
    }
  }
</style>
