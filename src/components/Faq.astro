---
import SectionHead from './SectionHead.astro';
import { FAQ, jsonLd } from '../i18n/faq';
import { getLocaleFromUrl } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const copy = FAQ[locale];

// Same identifiers Base.astro gives the page and the hotel, so the FAQ joins
// that graph instead of floating as a separate, unattached entity.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(`${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/'), Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: locale,
  isPartOf: { '@id': `${canonical}#webpage` },
  about: { '@id': `${home}#hotel` },
  mainEntity: copy.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section id="faq" aria-labelledby="faq-title" class="faq section-light">
  <div class="gutter faq__grid">
    <div class="faq__head">
      <SectionHead headingId="faq-title" title={copy.title} />
      <p class="faq__more">
        {copy.more}{' '}
        <a href="#contact">{copy.moreCta}</a>
      </p>
    </div>

    <div class="faq__list" data-faq>
      {
        copy.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__panel">
              <p class="faq__a">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={jsonLd(schema)} is:inline />
</section>

<style>
  .faq {
    padding-block: var(--spacing-section);
  }

  .faq__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    /* The questions run long; the heading stays in view beside them. */
    .faq__head {
      position: sticky;
      top: 7rem;
    }
  }

  .faq__more {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--color-forest-900) 78%, transparent);
  }

  .faq__more a {
    font-weight: 600;
    color: var(--color-bronze-600);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-bronze-600) 45%, transparent);
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .faq__item {
    border-top: 1px solid color-mix(in oklab, var(--color-forest-900) 16%, transparent);
  }

  .faq__item:last-child {
    border-bottom: 1px solid color-mix(in oklab, var(--color-forest-900) 16%, transparent);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 1rem + 0.55vw, 1.45rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-forest-900);
    transition: color 0.3s var(--ease-out-quart);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--color-bronze-600);
  }

  /* A drawn plus that turns into a minus: two hairlines, the vertical one
     folds flat when the answer opens. No box or circle around it; a framed
     plus beside every question read as a row of checkboxes. */
  .faq__icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1rem;
    height: 1.5px;
    background: var(--color-bronze-600);
    transform: translate(-50%, -50%);
    transition: transform 0.45s var(--ease-out-expo);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon::after,
  .faq__item.is-open .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  /* Once the script has taken over, the icon follows .is-open, which flips at
     the start of a close rather than when the panel has finished folding. */
  [data-faq][data-enhanced] .faq__item[open]:not(.is-open) .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Without the script: Chromium 131+ can still ease the height natively;
     Safari and Firefox open instantly, which is the correct fallback. */
  [data-faq]:not([data-enhanced]) .faq__item {
    interpolate-size: allow-keywords;
  }

  [data-faq]:not([data-enhanced]) .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease-out-expo),
      content-visibility 0.5s allow-discrete;
  }

  [data-faq]:not([data-enhanced]) .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__panel {
    overflow: hidden;
  }

  .faq__a {
    max-width: 62ch;
    padding-bottom: 1.6rem;
    padding-right: 3.75rem;
    color: color-mix(in oklab, var(--color-forest-900) 82%, transparent);
  }

  @media (max-width: 559px) {
    .faq__a {
      padding-right: 0;
    }
  }
</style>

<script>
  // Height animation for <details>, the same in every engine. The native element
  // still owns open/closed state, keyboard access and find-in-page; the script
  // only animates the panel between those states.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
    list.dataset.enhanced = '';

    list.querySelectorAll<HTMLDetailsElement>('.faq__item').forEach((item) => {
      const summary = item.querySelector('summary');
      const panel = item.querySelector<HTMLElement>('.faq__panel');
      if (!summary || !panel) return;

      let running: Animation | null = null;
      item.classList.toggle('is-open', item.open);

      const animate = (from: number, to: number, duration: number, onDone?: () => void) => {
        running?.cancel();
        running = panel.animate(
          [
            { height: `${from}px`, opacity: from === 0 ? 0 : 1 },
            { height: `${to}px`, opacity: to === 0 ? 0 : 1 },
          ],
          { duration, easing: EASE },
        );
        running.onfinish = () => {
          running = null;
          onDone?.();
        };
      };

      summary.addEventListener('click', (event) => {
        if (reduced.matches) return;
        event.preventDefault();

        // Mid-animation, start from the height it has right now so the motion
        // reverses instead of jumping. Otherwise start from the resting state:
        // a closed panel's measured height is stale, not 0, in every engine.
        const current = running
          ? panel.getBoundingClientRect().height
          : item.classList.contains('is-open')
            ? panel.scrollHeight
            : 0;

        if (!item.classList.contains('is-open')) {
          item.open = true;
          item.classList.add('is-open');
          animate(current, panel.scrollHeight, 480);
        } else {
          item.classList.remove('is-open');
          animate(current, 0, 360, () => {
            item.open = false;
          });
        }
      });

      // Opened by the browser itself (find-in-page, a hash link): keep the
      // icon state in step without animating.
      item.addEventListener('toggle', () => {
        if (!running) item.classList.toggle('is-open', item.open);
      });
    });
  });
</script>
