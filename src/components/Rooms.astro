---
import SectionHead from './SectionHead.astro';
import PhotoCarousel from './PhotoCarousel.astro';
import AmenityIcon from './AmenityIcon.astro';
import { ROOMS } from '../data/rooms';
import { FACTS } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations, formatNumber } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currency = locale === 'uk' ? '₴' : 'UAH';
---

<section id="rooms" class="rooms">
  <div class="gutter">
    <SectionHead eyebrow={t('rooms.eyebrow')} title={t('rooms.title')} lede={t('rooms.lede')} />
  </div>

  <ul class="gutter rooms__list" data-reveal-group>
    {
      ROOMS.map((room, i) => (
        <li class:list={['room', i % 2 === 1 && 'room--flip']} data-reveal>
          <div class="room__media">
            <PhotoCarousel photos={room.photos} label={t(`room.${room.key}.name`)} id={room.key} />
          </div>

          <div class="room__body">
            <p class="room__cap">{t(room.capacity)}</p>
            <h3 class="room__name">{t(`room.${room.key}.name`)}</h3>
            <p class="room__desc">{t(`room.${room.key}.desc`)}</p>

            <ul class="room__amenities">
              {
                room.amenities.map((a) => (
                  <li>
                    <AmenityIcon name={a} class="room__amenity-icon" />
                    <span>{t(`am.${a}`)}</span>
                  </li>
                ))
              }
            </ul>

            <div class="room__foot">
              <p class="room__price">
                <span class="room__price-from">{t('rooms.from')}</span>
                <span class="room__price-value">{formatNumber(locale, room.price)}</span>
                <span class="room__price-cur">{currency}</span>
                <span class="room__price-night">{t('rooms.night')}</span>
              </p>
              <a href={FACTS.booking} target="_blank" rel="noopener" class="btn btn-gold room__book">
                {t('rooms.book')}
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="gutter rooms__note" data-reveal>{t('rooms.note')}</p>
</section>

<style>
  .rooms {
    background: var(--color-forest-900);
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .rooms__list {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-inline: clamp(1.25rem, 5vw, 5rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Alternating rows rather than a card grid: six identical cards is the
     template look, and the offset keeps the eye moving down the page. */
  .room {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid color-mix(in oklab, var(--color-gold-700) 22%, transparent);
  }

  .rooms__list > .room:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  @media (min-width: 860px) {
    .room {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .room--flip .room__media {
      order: 2;
    }
  }

  .room__cap {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-500);
  }

  .room__name {
    margin-top: 0.7rem;
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
  }

  .room__desc {
    margin-top: 0.9rem;
    max-width: 44ch;
    color: color-mix(in oklab, var(--color-cream) 76%, transparent);
  }

  /* Small pills buried the amenities. A two-column icon list at readable size
     makes what is actually in the room the second thing you take in. */
  .room__amenities {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 1.4rem 0 0;
    border-top: 1px solid color-mix(in oklab, var(--color-gold-700) 26%, transparent);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1.25rem;
  }

  .room__amenities li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    color: var(--color-cream);
  }

  /* Only the colour here; the size lives in AmenityIcon.astro because scoped
     styles cannot reach into another component's markup. */
  .room__amenities li {
    color: var(--color-cream);
  }

  .room__amenities :global(.amenity-icon) {
    color: var(--color-gold-500);
  }

  @media (max-width: 420px) {
    .room__amenities {
      grid-template-columns: 1fr;
    }
  }

  /* Price as fine editorial type, not a badge. The luxury convention is to
     hide price entirely, but at this price point it is a selling point. */
  .room__price {
    margin-top: 1.7rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .room__price-from {
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--color-cream) 60%, transparent);
  }

  .room__price-value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    line-height: 1;
    color: var(--color-gold-500);
  }

  .room__price-cur {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-gold-500);
  }

  .room__price-night {
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--color-cream) 60%, transparent);
  }

  /* Price and the booking action share a baseline row, so every room has its
     own way straight through to Booking.com. */
  .room__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.7rem;
  }

  .room__price {
    margin-top: 0;
  }

  .room__book {
    padding: 0.78rem 1.5rem;
    font-size: 0.85rem;
  }

  .rooms__note {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    font-size: 0.88rem;
    color: color-mix(in oklab, var(--color-cream) 62%, transparent);
  }
</style>
