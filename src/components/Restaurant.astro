---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import terrace from '../assets/photos/restaurant-terrace.jpg';
import PhotoCarousel from './PhotoCarousel.astro';

// Glob so dropping another food-<n>.jpg into assets/photos/food extends the
// carousel with no code change.
const foodFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/food/*.jpg', { eager: true });
const foodPhotos = Object.entries(foodFiles)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, m]) => m.default);
import SectionHead from './SectionHead.astro';
import { FACTS } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations, formatNumber } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const stats = [
  { value: formatNumber(locale, FACTS.restaurantSeats), label: t('restaurant.stat.seats') },
  { value: t('restaurant.stat.breakfastValue'), label: t('restaurant.stat.breakfast') },
  { value: t('restaurant.stat.cuisineValue'), label: t('restaurant.stat.cuisine') },
];
---

<section id="restaurant" class="restaurant section-light">
  <div class="gutter restaurant__grid" data-reveal-group>
    <div class="restaurant__media">
      <div class="restaurant__figure restaurant__figure--tall" data-reveal="mask">
        <PhotoCarousel photos={foodPhotos} label={t('restaurant.title')} id="food" />
      </div>
      <figure class="restaurant__figure restaurant__figure--wide zoom-figure" data-reveal="mask">
        <Image src={terrace} alt={t('grounds.alt.terrace')} widths={[400, 700, 900]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" />
      </figure>
    </div>

    <div class="restaurant__copy">
      <SectionHead eyebrow={t('restaurant.eyebrow')} title={t('restaurant.title')} lede={t('restaurant.body')} />

      <div class="restaurant__actions" data-reveal>
        <a href={FACTS.menuPdf} target="_blank" rel="noopener" class="btn btn-dark">{t('restaurant.menuCta')}</a>
        <a href={`tel:${FACTS.phone}`} class="btn btn-quiet">{t('restaurant.tableCta')}</a>
      </div>

      <dl class="restaurant__stats">
        {
          stats.map((s) => (
            <div data-reveal>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .restaurant {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .restaurant__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .restaurant__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    }
  }

  /* The food shot is a tall portrait and the terrace a landscape, so they are
     paired as an offset diptych rather than forced into one aspect ratio. */
  .restaurant__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: end;
  }

  .restaurant__figure {
    margin: 0;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 28px 55px -34px oklch(0.185 0.055 139.5 / 0.5);
  }

  .restaurant__figure img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .restaurant__figure--tall :global(.carousel__slide img) {
    aspect-ratio: 3 / 4;
  }

  .restaurant__figure--wide img {
    aspect-ratio: 1;
  }

  .restaurant__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.25rem;
  }

  /* A quiet secondary action on the light ground. */
  .btn-quiet {
    border: 1px solid color-mix(in oklab, var(--color-forest-900) 24%, transparent);
    color: var(--color-forest-900);
  }
  .btn-quiet:hover {
    border-color: var(--color-forest-900);
    background: var(--color-forest-900);
    color: var(--color-cream);
  }

  .restaurant__stats {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-forest-900) 12%, transparent);
  }

  @media (min-width: 560px) {
    .restaurant__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .restaurant__stats dt {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-600);
  }

  .restaurant__stats dd {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.2;
    color: var(--color-forest-900);
  }
</style>
