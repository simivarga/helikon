# Cloudflare Pages reads this file; other hosts ignore it harmlessly.
#
# Everything under /_astro/ carries a content hash in its filename, so a change
# always produces a new URL. That makes it safe to cache forever — a returning
# guest re-downloads nothing but the HTML.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The share image is a stable, unhashed URL, so it can only be cached for a
# day: replacing it must actually reach the social scrapers.
/og/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML must always be revalidated, or a deploy would not reach anyone.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
